# Copy this file to .env and set the paths for your machine.
# All four are host paths mounted into the backend container.

# Clone of https://github.com/DepthAnything/Depth-Anything-V2
DEPTH_ANYTHING_REPO=/path/to/Depth-Anything-V2

# Directory containing depth_anything_v2_vitl.pth
FOG_MAKER_CHECKPOINTS=/path/to/fog-maker/checkpoints

# Clone of https://github.com/IDKiro/DehazeFormer
# with save_models/indoor/dehazeformer-w.pth downloaded
DEHAZEFORMER_REPO=/path/to/DehazeFormer

# Clone of https://github.com/swz30/MPRNet
# with Deraining/pretrained_models/model_deraining.pth downloaded
MPRNET_REPO=/path/to/MPRNet
